# Every value below is read by @repo/app-session/env and nowhere else (ADR 0012). A missing
# or short value is refused when the server boots (instrumentation.ts).

# Where the internal API listens. Not published: the browser never calls it.
API_BASE_URL=http://localhost:4321

# This app's service key: the right-hand side of its entry in the API's
# SERVICE_KEYS (e.g. SERVICE_KEYS=microtask=<theirs>,macroplan=<this value>). It
# names the app and confers no authority on its own. It is NOT Microtask's key:
# one key per product is what lets the API record which one made a call (ADR 0014).
API_KEY=change-me-to-the-macroplan-service-key

# Seals the mp_admin cookie (AES-256-GCM), the only cookie this app sets. At least
# 32 BYTES, distinct from the API's SESSION_SECRET (ADR 0032) and from Microtask's
# COOKIE_SECRET. Generate one with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
# Left empty on purpose: a placeholder long enough to pass the 32-byte check would
# be a publicly known key that boots without complaint.
COOKIE_SECRET=
