# Every value below is read by lib/env.ts and nowhere else (ADR 0012). A missing
# or short value is refused on the first request that needs it.

# Where the internal API listens. Not published: the browser never calls it.
API_BASE_URL=http://localhost:4321

# This app's service key: the right-hand side of its entry in the API's
# SERVICE_KEYS (e.g. SERVICE_KEYS=microtask=<this value>). It names the app and
# confers no authority on its own.
API_KEY=change-me-to-the-microtask-service-key

# Seals the mt_admin and mt_link cookies (AES-256-GCM). At least 32 BYTES, and
# distinct from the API's SESSION_SECRET (ADR 0032). Generate one with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
COOKIE_SECRET=change-me-to-at-least-32-bytes-of-randomness
