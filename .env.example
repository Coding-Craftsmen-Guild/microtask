# Every variable docker-compose.yml needs. Each is left EMPTY on purpose: compose refuses to start
# while any of them is unset or empty, so copying this file unchanged fails loudly instead of
# starting with a placeholder secret. Fill each one in a gitignored .env or the host's environment.
#
# Generate the random ones with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"

# The one admin password (ADR 0012). The API refuses to start without it. Both apps sign in
# against it, through the product-agnostic /v1/auth/login: one admin, two sessions (ADR 0014).
ADMIN_PASSWORD=

# Signs the admin bearer tokens the API mints. At least 32 characters.
SESSION_SECRET=

# Seals an epic's Microtask binding token at rest, with @repo/kernel's sealing primitive (design
# §7.2, ADR 0052). Must differ from SESSION_SECRET, COOKIE_SECRET and MACROPLAN_COOKIE_SECRET: two
# secrets sharing a value let whichever one is compromised open blobs sealed under the other. At
# least 32 characters: seal derives its AES key as sha256(this), so a short one is a weak key.
BRIDGE_SECRET=

# The service key naming Microtask to the API; compose hands it to both sides.
MICROTASK_API_KEY=

# Seals the mt_admin cookie. At least 32 bytes, and not SESSION_SECRET (ADR 0032).
COOKIE_SECRET=

# Next's Server Actions key for Microtask: base64 of 32 random bytes, and the SAME value on every
# deploy (ADR 0026).
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=

# The service key naming Macroplan to the API. A DIFFERENT value from MICROTASK_API_KEY: one key
# per product is what lets the API record which product made a call (ADR 0014).
MACROPLAN_API_KEY=

# Seals the mp_admin cookie. At least 32 bytes, and not SESSION_SECRET or COOKIE_SECRET: two
# products sharing a cookie secret would each be able to open the other's session (ADR 0032).
MACROPLAN_COOKIE_SECRET=

# Next's Server Actions key for Macroplan: base64 of 32 random bytes, its own, and the SAME value
# on every deploy (ADR 0026).
MACROPLAN_SERVER_ACTIONS_ENCRYPTION_KEY=
