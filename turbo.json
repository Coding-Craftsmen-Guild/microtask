{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": [
        "^build"
      ]
    },
    "lint": {},
    "test": {
      "dependsOn": [
        "^build"
      ]
    },
    "//#check-exports": {
      "dependsOn": [
        "@repo/api-client#build",
        "@repo/contracts#build",
        "@repo/kernel#build",
        "@repo/macroplan-domain#build",
        "@repo/microtask-domain#build",
        "@repo/schedule#build",
        "@repo/store#build",
        "api#build",
        "macroplan#build",
        "microtask#build"
      ],
      "cache": false
    }
  }
}
